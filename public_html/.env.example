# Copie este arquivo para .env e preencha os valores reais

# Database
DB_HOST=localhost
DB_USER=your_db_user_here
DB_PASS=your_db_password_here
DB_NAME=your_db_name_here

# Email (SMTP)
SMTP_HOST=smtp.hostinger.com.br
SMTP_PORT=465
SMTP_USER=contato@risenglish.com.br
SMTP_PASS=your_smtp_password_here
SMTP_FROM=contato@risenglish.com.br
SMTP_FROM_NAME="Risenglish"
SMTP_SECURE=ssl

# App
APP_URL=https://risenglish.com.br
